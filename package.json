{
  "name": "idb-stories",
  "version": "0.1.0",
  "private": true,
  "description": "Сервис сторис ИДБ: публичная лента, админка, медиа-пайплайн, веб-плеер",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "openapi:generate": "pnpm --filter @idb-stories/schema run openapi:generate",
    "openapi:check": "pnpm --filter @idb-stories/schema run openapi:check",
    "db:generate": "pnpm --filter @idb-stories/db run generate",
    "db:migrate": "pnpm --filter @idb-stories/db run migrate:deploy",
    "db:migrate:dev": "pnpm --filter @idb-stories/db run migrate:dev",
    "db:seed": "pnpm --filter @idb-stories/db run seed",
    "dev:api": "pnpm --filter @idb-stories/api run dev",
    "dev:jobs": "pnpm --filter @idb-stories/worker run dev:jobs",
    "dev:media": "pnpm --filter @idb-stories/worker run dev:media",
    "dev:admin": "pnpm --filter @idb-stories/admin run dev",
    "e2e": "pnpm --filter @idb-stories/admin run e2e",
    "dev:local": "tsx scripts/dev/stack.ts",
    "smoke": "tsx scripts/dev/smoke.ts",
    "seed:demo": "tsx scripts/dev/seed-demo.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@idb-stories/adapters": "workspace:*",
    "@idb-stories/core": "workspace:*",
    "@idb-stories/db": "workspace:*",
    "@idb-stories/schema": "workspace:*",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^3.2.7",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.6.0",
    "redis-memory-server": "^0.17.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
