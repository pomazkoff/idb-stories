# Переменные окружения API и воркеров. Полный список и проверки — apps/api/src/config.ts, apps/worker/src/config.ts.
# В проде секреты приходят только из secret manager (раздел 10.2, T11); этот файл — образец для локального запуска без Docker.
NODE_ENV=development
LOG_LEVEL=info
API_SURFACES=public,admin
PUBLIC_PORT=8080
ADMIN_PORT=8081
DATABASE_URL=postgresql://stories_app:dev-app-password@localhost:5432/stories
REDIS_URL=redis://:dev-redis-password@localhost:6379
REDIS_PREFIX=stories:
CDN_BASE_URL=http://localhost:9000/stories-public
PUBLIC_CORS_ORIGINS=http://localhost:5173
SEGMENTS_CACHE_SALT=change-me-random-salt-at-least-16
ADMIN_ORIGIN=http://localhost:5173
ADMIN_COOKIE_SECURE=false
SSO_PROVIDER=mock
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=dev-s3-access-key
S3_SECRET_ACCESS_KEY=dev-s3-secret-key-change-me
CUSTOMER_AUTH_PROVIDER=mock
CUSTOMER_AUTH_MOCK_SECRET=dev-customer-token-secret-0123456789ab
